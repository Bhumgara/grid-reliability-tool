# Environment variables used by the backend. Copy to .env and fill in.
# Nothing loads .env automatically yet: set these in your shell or host
# (a container env file will read it from 2.5 onwards). Never commit .env.

# Browser origins allowed to call the API (CORS), comma-separated, no paths.
# Only the Flutter web build needs this; native apps ignore CORS.
# Unset or empty: no cross-origin access.
# Local web dev: run `flutter run -d chrome --web-port 5000` and allow that port.
GRID_CORS_ORIGINS=http://localhost:5000

# Data folder: grid.db, raw API responses and processed outputs. Unset: the
# repo's data/ folder. Set it to keep data elsewhere, e.g. a container volume
# (/data). Relative paths are taken from the current directory.
GRID_DATA_DIR=

# Zip bundle downloaded on first run when data/grid.db is missing
# (see core/deployment.py). The Streamlit app reads the
# deployment_bundle_url secret first.
DEPLOYMENT_BUNDLE_URL=

# The Streamlit dashboard's own refresh thread. Only one refresher should run,
# so set this to 0 (or false, no, off) wherever `python -m backend.worker` is
# running. Unset: on, as the deployed dashboard has no separate worker.
GRID_DASHBOARD_REFRESH=1
