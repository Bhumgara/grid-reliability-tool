# Keep the build context small and free of local data and secrets. The
# Dockerfile copies only named folders, but the whole context is still sent
# to the builder, so exclude anything large or private.

.git
.gitignore
.dockerignore
Dockerfile
compose.yaml

# Local data, secrets and settings
data/
.env
.env.*
!.env.example
.streamlit/secrets.toml
results.json
deployment_bundle*

# Python caches and environments
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# Not needed in the image
tests/
docs/
dashboard/
tokens/
app/
app.py
*.md
.vscode/
.idea/
