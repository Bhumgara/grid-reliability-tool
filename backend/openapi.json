  "components": {
    "schemas": {
      "DemandHistoryResponse": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ok",
            "title": "State",
            "default": "ok"
          },
          "as_of_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Utc"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/DemandPoint"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "points"
        ],
        "title": "DemandHistoryResponse",
        "description": "Demand per settlement period, oldest first, with internal gaps estimated.\n``as_of_utc`` is the last period."
      },
      "DemandPoint": {
        "properties": {
          "time_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Time Utc"
          },
          "demand_gw": {
            "type": "number",
            "title": "Demand Gw"
          },
          "estimated": {
            "type": "boolean",
            "title": "Estimated"
          }
        },
        "type": "object",
        "required": [
          "time_utc",
          "demand_gw",
          "estimated"
        ],
        "title": "DemandPoint"
      },
      "DrmBridge": {
        "properties": {
          "current_drm_gw": {
            "type": "number",
            "title": "Current Drm Gw"
          },
          "predicted_drm_gw": {
            "type": "number",
            "title": "Predicted Drm Gw"
          },
          "change_gw": {
            "type": "number",
            "title": "Change Gw"
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "flat"
            ],
            "title": "Direction"
          },
          "axis_min_gw": {
            "type": "number",
            "title": "Axis Min Gw"
          },
          "axis_max_gw": {
            "type": "number",
            "title": "Axis Max Gw"
          }
        },
        "type": "object",
        "required": [
          "current_drm_gw",
          "predicted_drm_gw",
          "change_gw",
          "direction",
          "axis_min_gw",
          "axis_max_gw"
        ],
        "title": "DrmBridge",
        "description": "Change from the latest margin to the forecast, with a padded axis range."
      },
      "EmptyState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "unavailable",
              "insufficient"
            ],
            "title": "State"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "state",
          "message"
        ],
        "title": "EmptyState",
        "description": "Returned instead of data when a section has nothing to show."
      },
      "Flow": {
        "properties": {
          "country": {
            "type": "string",
            "title": "Country"
          },
          "flow_gw": {
            "type": "number",
