            "title": "Generated At Utc"
          },
          "predicted_drm_gw": {
            "type": "number",
            "title": "Predicted Drm Gw"
          },
          "latest_drm_gw": {
            "type": "number",
            "title": "Latest Drm Gw"
          },
          "latest_time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Time Utc"
          },
          "percentile": {
            "type": "number",
            "title": "Percentile"
          },
          "percentile_description": {
            "type": "string",
            "title": "Percentile Description"
          },
          "bridge": {
            "$ref": "#/components/schemas/DrmBridge"
          }
        },
        "type": "object",
        "required": [
          "target_time_utc",
          "forecast_origin_utc",
          "generated_at_utc",
          "predicted_drm_gw",
          "latest_drm_gw",
          "latest_time_utc",
          "percentile",
          "percentile_description",
          "bridge"
        ],
        "title": "ForecastHeroResponse",
        "description": "``as_of_utc`` is when the forecast was generated."
      },
      "GenerationChangeResponse": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ok",
            "title": "State",
            "default": "ok"
          },
          "as_of_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Utc"
          },
          "latest_time_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Latest Time Utc"
          },
          "earlier_time_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Earlier Time Utc"
          },
          "movements": {
            "items": {
              "$ref": "#/components/schemas/Movement"
