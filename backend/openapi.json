          "as_of_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Utc"
          },
          "drm_gw": {
            "type": "number",
            "title": "Drm Gw"
          },
          "drm_time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drm Time Utc"
          },
          "demand_gw": {
            "type": "number",
            "title": "Demand Gw"
          },
          "demand_time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Demand Time Utc"
          },
          "tracked_generation_gw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tracked Generation Gw"
          },
          "generation_time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Time Utc"
          },
          "stale_after_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale After Utc"
          }
