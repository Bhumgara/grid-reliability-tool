            "title": "As Of Utc"
          },
          "target_time_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Target Time Utc"
          },
          "forecast_origin_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forecast Origin Utc"
          },
          "generated_at_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
