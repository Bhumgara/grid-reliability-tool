        "title": "GenerationChangeResponse",
        "description": "Largest changes in FUELHH output per fuel. ``as_of_utc`` is ``latest_time_utc``."
      },
      "GenerationLiveResponse": {
        "properties": {
          "state": {
            "type": "string",
            "const": "ok",
            "title": "State",
            "default": "ok"
